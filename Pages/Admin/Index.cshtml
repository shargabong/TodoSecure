@page
@model TodoSecure.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Админ-панель";
}

<h2>Пользователи</h2>

<table class="table">
    <thead>
        <tr>
            <th>Email</th>
            <th>FullName</th>
            <th>Роли</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var u in Model.Users)
    {
        <tr>
            <td>@u.Email</td>
            <td>@u.FullName</td>
            <td>@string.Join(", ", u.Roles)</td>
        </tr>
    }
    </tbody>
</table>